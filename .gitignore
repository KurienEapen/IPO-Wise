# ==============================================================================
# IPO-Wise .gitignore
# ==============================================================================

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE & Editor Configurations
.idea/
.vscode/
*.swp
*.swo
*~

# Python Bytecode & Cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/

# Virtual Environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# SQLite & Local Databases (preserve production state)
*.db
*.db-journal
*.sqlite
*.sqlite3
*.db-shm
*.db-wal

# Zip & Deployment Archives
*.zip
*.tar
*.tar.gz
*.tgz

# Environment Variables & Secrets
.env
.env.*
!.env.example
!.env.sample
*.pem
*.key

# Logs & Process Monitoring
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pm2.log
*.pid

# Local AI / Tooling Caches & Overrides
.codex/
.impeccable/config.local.json
.impeccable/live/
